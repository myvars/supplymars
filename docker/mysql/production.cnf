# MySQL for the small production server (#86): one 2 GB host runs two stacks, each with its own MySQL.
# Mounted by compose.prod.yaml only; development keeps the image's defaults. See Docs/06-operations.md.
[mysqld]
# The largest saving: its buffers are sized for a big server. The app never reads it; phpMyAdmin's
# status pages and most sys schema views lose their data
performance_schema = OFF

# The app needs its FrankenPHP threads, the Messenger worker, the playground reset and the odd console
# command or phpMyAdmin session. Default 151
max_connections = 50

# Allocated up front. The app's transactions are small. Default 64M
innodb_log_buffer_size = 16M

# The X Protocol (port 33060), which nothing uses
mysqlx = OFF

# Binary logging, on by default with 30 days' retention. Nothing reads the logs (no replica; the backup is
# mysqldump), and the playground's nightly restore logs 1-2 GB a night: 24 GB had built up by 2026-10-26 (#143)
disable_log_bin

# innodb_buffer_pool_size stays at the default 128M. Live's data (about 1.8 GB, mostly status_change_log)
# cannot fit in memory on this host anyway, and the pages the app reads do: 99.98% of reads hit the pool
