# Symfony runtime and temp data
/var/
/vendor/
/public/bundles/
/public/uploads/
/config/secrets/prod/prod.decrypt.private.php

# Asset Mapper output
/public/assets/
/assets/vendor/

# Tests and docs are not in the image. Leaving them out keeps the build cache valid when only they change
/tests/
/Docs/

# Environment config files — copy explicitly in Dockerfile
.env.local
.env.*.local
.env.test
.env.dev

# Git-related
.git
.gitignore

# Editor and OS files
.idea/
.DS_Store
Thumbs.db
*.log
*.swp
*.swo
*.bak
*.tmp
*.orig

# PHPUnit and PHP-CS-Fixer caches
/.phpunit.cache
/.php-cs-fixer.cache

# Docker
.dockerignore
