<header class="mt-3">
    {# A <div>, not a <nav>: it contains the sidebar's own <nav>. #}
    <div class="rounded-t-lg border-b border-gray-700/50 bg-gray-900 shadow-lg dark:shadow-black/30">
        <div class="mx-auto flex max-w-(--breakpoint-xl) items-center justify-between px-3 py-2.5 sm:px-4">

            <div class="flex min-w-0 items-center">
                {{ include('_menu.html.twig') }}
                <a href="{{ path('app_homepage') }}" class="mx-2 flex min-w-0 items-center sm:mx-4 rtl:space-x-reverse"
                   data-turbo-frame="body">
                    <div class="shrink [&_svg]:h-auto [&_svg]:max-h-8 [&_svg]:w-full">
                        {{ include('_logo.html.twig', { 'logoHeight': 32 }) }}
                    </div>
                </a>
            </div>
            <div class="flex shrink-0 items-center gap-1.5 md:order-2">
                {{ include('_help_drawer.html.twig') }}
                <div data-controller="theme-toggle">
                    <twig:Button variant="ghost" size="icon" class="size-9 text-gray-400 hover:bg-gray-700/70 hover:text-gray-200 aria-expanded:bg-gray-700/70 aria-expanded:text-gray-200 dark:hover:bg-gray-700/70" data-action="theme-toggle#toggle">
                        <span class="sr-only">Toggle dark mode</span>
                        <span data-theme-toggle-target="sunIcon" class="hidden">
                            <twig:ux:icon name="flowbite:sun-solid" class="size-5"/>
                        </span>
                        <span data-theme-toggle-target="moonIcon" class="hidden">
                            <twig:ux:icon name="flowbite:moon-solid" class="size-5"/>
                        </span>
                    </twig:Button>
                </div>
                {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                    <twig:DropdownMenu id="user" align="end">
                        <twig:DropdownMenu:Trigger>
                            <twig:Button variant="ghost" size="icon-sm" class="rounded-full hover:bg-gray-700/70 aria-expanded:bg-gray-700/70 dark:hover:bg-gray-700/70" {{ ...dropdown_menu_trigger_attrs }}>
                                <span class="sr-only">Open user menu</span>
                                <twig:Avatar class="size-7 ring-2 ring-gray-600">
                                    <twig:Avatar:Image src="{{ asset('images/avatar.png') }}"/>
                                    <twig:Avatar:Fallback class="text-xs">{{ app.user.fullName|default('?')|first|upper }}</twig:Avatar:Fallback>
                                </twig:Avatar>
                            </twig:Button>
                        </twig:DropdownMenu:Trigger>
                        <twig:DropdownMenu:Content class="w-52">
                            <twig:DropdownMenu:Label>
                                <p class="text-sm font-medium text-foreground">{{ app.user.fullName }}</p>
                                <p class="mt-0.5 truncate text-xs font-normal text-muted-foreground">{{ app.user.userIdentifier }}</p>
                            </twig:DropdownMenu:Label>
                            <twig:DropdownMenu:Separator />
                            <twig:DropdownMenu:Item as="a" href="{{ path('app_customer_show', { id: app.user.publicId }) }}" data-turbo-frame="body">
                                <twig:ux:icon name="flowbite:cog-solid" class="text-muted-foreground"/>
                                Settings
                            </twig:DropdownMenu:Item>
                            <twig:DropdownMenu:Item as="a" href="{{ path('app_logout') }}" data-turbo-prefetch="false" data-turbo-frame="_top">
                                <twig:ux:icon name="flowbite:arrow-right-to-bracket-outline" class="text-muted-foreground"/>
                                Sign Out
                            </twig:DropdownMenu:Item>
                        </twig:DropdownMenu:Content>
                    </twig:DropdownMenu>
                {% else %}
                    <twig:Button as="a" href="{{ path('app_login') }}" variant="ghost" class="size-9 px-0 font-medium text-gray-400 hover:bg-gray-700/70 hover:text-gray-200 aria-expanded:bg-gray-700/70 aria-expanded:text-gray-200 dark:hover:bg-gray-700/70 sm:w-auto sm:px-2.5 sm:text-xs" data-turbo-frame="_top">
                        <twig:ux:icon name="flowbite:arrow-right-to-bracket-outline" class="size-5 sm:hidden"/>
                        <span class="sr-only sm:not-sr-only">Sign In</span>
                    </twig:Button>
                {% endif %}
            </div>
        </div>
    </div>
</header>
