{# Sidebar navigation: the header's menu button and the panel it opens, as a kit Sheet
   (a modal <dialog> sliding in from the left). Links close it as they navigate.
   Active link state and the collapsible sections are managed by the sidebar-active controller.
   Sections: Home, Catalog, Orders, Purchasing, Customers, Reviews, Reporting, Admin, Notes #}
<twig:Sheet id="menu" side="left" data-action="turbo:before-cache@window->dialog#close">
    <twig:Sheet:Trigger>
        {# The header bar is dark in both modes, so the ghost button's colours are pinned. #}
        <twig:Button id="navigationButton" variant="ghost" size="icon" class="size-9 text-gray-400 hover:bg-gray-700/70 hover:text-gray-200 aria-expanded:bg-gray-700/70 aria-expanded:text-gray-200 dark:hover:bg-gray-700/70" {{ ...sheet_trigger_attrs }}>
            <span class="sr-only">Open side menu</span>
            <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/></svg>
        </twig:Button>
    </twig:Sheet:Trigger>
    {# The inner div fills the dialog, so a click on empty menu space is not taken for a click outside. #}
    <twig:Sheet:Content class="w-72 gap-0" :showCloseButton="false">
    <div class="flex min-h-0 flex-1 flex-col overflow-y-auto">
        <twig:Sheet:Title class="sr-only">Main menu</twig:Sheet:Title>
        <div class="flex items-center justify-between border-b border-gray-200 px-5 py-4 dark:border-white/[0.06]">
            <a href="{{ path('app_homepage') }}" data-turbo-frame="body" data-action="dialog#close">
                {{ include('_logo.html.twig', { 'logoHeight': 28 }) }}
            </a>
            <twig:Button variant="ghost" size="icon-sm" class="text-muted-foreground" data-action="dialog#close">
                <svg aria-hidden="true" class="size-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                <span class="sr-only">Close menu</span>
            </twig:Button>
        </div>
        {% set badges = sidebar_badges() %}
        <nav class="flex-1 px-3 py-4"
             data-controller="sidebar-active"
             data-action="turbo:frame-load@window->sidebar-active#update">
            <ul class="space-y-1">
                {# ── Home ── #}
                <li>
                    <a href="{{ path('app_homepage') }}"
                       data-nav="top"
                       class="flex items-center rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-gray-900 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800"
                       data-turbo-frame="body"
                       data-action="dialog#close"
                    >
                        <twig:ux:icon name="flowbite:home-solid" data-nav="icon" class="h-5 w-5 text-gray-500 dark:text-gray-400"/>
                        <span class="ml-3">Home</span>
                    </a>
                </li>
                {# ── Dashboard ── #}
                {% if is_granted('ROLE_ADMIN') %}
                <li>
                    <a href="{{ path('app_dashboard') }}"
                       data-nav="top"
                       class="flex items-center rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-gray-900 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800"
                       data-turbo-frame="body"
                       data-action="dialog#close"
                    >
                        <twig:ux:icon name="bi:speedometer2" data-nav="icon" class="h-5 w-5 text-gray-500 dark:text-gray-400"/>
                        <span class="ml-3">Dashboard</span>
                    </a>
                </li>
                {% endif %}
                {# ── Catalog (Products, Categories, Subcategories, Manufacturers) ── #}
                <li>
                    <button type="button" data-nav="section" class="flex w-full items-center rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-gray-900 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800" aria-controls="dropdown-catalog" aria-expanded="false" data-action="sidebar-active#toggle">
                        <twig:ux:icon name="bi:box-seam-fill" data-nav="icon" class="h-5 w-5 text-gray-500 dark:text-gray-400"/>
                        <span class="ml-3 flex-1 whitespace-nowrap text-left">Catalog</span>
                        <twig:ux:icon name="bi:chevron-down" data-nav="chevron" class="h-4 w-4 text-gray-400"/>
                    </button>
                    <ul id="dropdown-catalog" data-nav="dropdown" class="mt-1 hidden space-y-0.5 pl-4">
                        <li>
                            <a href="{{ path('app_catalog_product_index') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Products</a>
                        </li>
                        <li>
                            <a href="{{ path('app_catalog_category_index') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Categories</a>
                        </li>
                        <li>
                            <a href="{{ path('app_catalog_subcategory_index') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Subcategories</a>
                        </li>
                        <li>
                            <a href="{{ path('app_catalog_manufacturer_index') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Manufacturers</a>
                        </li>
                    </ul>
                </li>
                {# ── Orders (Order Search, Pending Orders) ── #}
                <li>
                    <button type="button" data-nav="section" class="flex w-full items-center rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-gray-900 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800" aria-controls="dropdown-orders" aria-expanded="false" data-action="sidebar-active#toggle">
                        <twig:ux:icon name="bi:bag-check" data-nav="icon" class="h-5 w-5 text-gray-500 dark:text-gray-400"/>
                        <span class="ml-3 flex-1 whitespace-nowrap text-left">Orders</span>
                        <twig:ux:icon name="bi:chevron-down" data-nav="chevron" class="h-4 w-4 text-gray-400"/>
                    </button>
                    <ul id="dropdown-orders" data-nav="dropdown" class="mt-1 hidden space-y-0.5 pl-4">
                        <li>
                            <a href="{{ path('app_order_index') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Orders</a>
                        </li>
                        <li>
                            <a href="{{ path('app_order_index', {orderStatus: 'PENDING'}) }}"
                               data-nav="child"
                               class="flex w-full items-center justify-between rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Pending Orders{% if badges.pendingOrders > 0 %}<span class="ml-auto inline-flex items-center rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400">{{ badges.pendingOrders }}</span>{% endif %}</a>
                        </li>
                    </ul>
                </li>

                {# ── Purchasing (POs, Suppliers, Supplier Products) ── #}
                <li>
                    <button type="button" data-nav="section" class="flex w-full items-center rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-gray-900 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800" aria-controls="dropdown-purchasing" aria-expanded="false" data-action="sidebar-active#toggle">
                        <twig:ux:icon name="bi:building" data-nav="icon" class="h-5 w-5 text-gray-500 dark:text-gray-400"/>
                        <span class="ml-3 flex-1 whitespace-nowrap text-left">Purchasing</span>
                        <twig:ux:icon name="bi:chevron-down" data-nav="chevron" class="h-4 w-4 text-gray-400"/>
                    </button>
                    <ul id="dropdown-purchasing" data-nav="dropdown" class="mt-1 hidden space-y-0.5 pl-4">
                        <li>
                            <a href="{{ path('app_purchasing_purchase_order_index') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Purchase Orders</a>
                        </li>
                        <li>
                            <a href="{{ path('app_purchasing_supplier_index') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Suppliers</a>
                        </li>
                        <li>
                            <a href="{{ path('app_purchasing_supplier_product_index') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Supplier Products</a>
                        </li>
                    </ul>
                </li>
                {# ── Customers ── #}
                <li>
                    <a href="{{ path('app_customer_index') }}"
                       data-nav="top"
                       class="flex items-center rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-gray-900 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800"
                       data-turbo-frame="body"
                       data-action="dialog#close"
                    >
                        <twig:ux:icon name="flowbite:users-solid" data-nav="icon" class="h-5 w-5 text-gray-500 dark:text-gray-400"/>
                        <span class="ml-3 flex-1 whitespace-nowrap text-left">Customers</span>
                    </a>
                </li>
                {# ── Reviews (Search, Moderation Queue) ── #}
                <li>
                    <button type="button" data-nav="section" class="flex w-full items-center rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-gray-900 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800" aria-controls="dropdown-reviews" aria-expanded="false" data-action="sidebar-active#toggle">
                        <twig:ux:icon name="flowbite:star-solid" data-nav="icon" class="h-5 w-5 text-gray-500 dark:text-gray-400"/>
                        <span class="ml-3 flex-1 whitespace-nowrap text-left">Reviews</span>
                        <twig:ux:icon name="bi:chevron-down" data-nav="chevron" class="h-4 w-4 text-gray-400"/>
                    </button>
                    <ul id="dropdown-reviews" data-nav="dropdown" class="mt-1 hidden space-y-0.5 pl-4">
                        <li>
                            <a href="{{ path('app_review_index') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Review Search</a>
                        </li>
                        <li>
                            <a href="{{ path('app_review_index', {reviewStatus: 'PENDING'}) }}"
                               data-nav="child"
                               class="flex w-full items-center justify-between rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Moderation Queue{% if badges.pendingReviews > 0 %}<span class="ml-auto inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800 dark:bg-red-900/30 dark:text-red-400">{{ badges.pendingReviews }}</span>{% endif %}</a>
                        </li>
                    </ul>
                </li>
                {# ── Reporting (Reports, Summaries) ── #}
                <li>
                    <button type="button" data-nav="section" class="flex w-full items-center rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-gray-900 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800" aria-controls="dropdown-reporting" aria-expanded="false" data-action="sidebar-active#toggle">
                        <twig:ux:icon name="bi:bar-chart-line-fill" data-nav="icon" class="h-5 w-5 text-gray-500 dark:text-gray-400"/>
                        <span class="ml-3 flex-1 whitespace-nowrap text-left">Reporting</span>
                        <twig:ux:icon name="bi:chevron-down" data-nav="chevron" class="h-4 w-4 text-gray-400"/>
                    </button>
                    <ul id="dropdown-reporting" data-nav="dropdown" class="mt-1 hidden space-y-0.5 pl-4">
                        <li>
                            <a href="{{ path('app_reports_product_sales') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Product Sales</a>
                        </li>
                        <li>
                            <a href="{{ path('app_reports_order_summary') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Order Summary</a>
                        </li>
                        <li>
                            <a href="{{ path('app_reports_customer_insights') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Customer Insights</a>
                        </li>
                        <li>
                            <a href="{{ path('app_reports_po_performance') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >PO Performance</a>
                        </li>
                        <li>
                            <a href="{{ path('app_reports_overdue_orders', {'duration': 'last30'}) }}"
                               data-nav="child"
                               class="flex w-full items-center justify-between rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Overdue Orders{% if badges.overdueOrders > 0 %}<span class="ml-auto inline-flex items-center rounded-full bg-orange-100 px-2 py-0.5 text-xs font-medium text-orange-800 dark:bg-orange-900/30 dark:text-orange-400">{{ badges.overdueOrders }}</span>{% endif %}</a>
                        </li>
                        <li>
                            <a href="{{ path('app_purchasing_purchase_order_index', {'purchaseOrderStatus': 'REJECTED'}) }}"
                               data-nav="child"
                               class="flex w-full items-center justify-between rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >Rejected POs{% if badges.rejectedPos > 0 %}<span class="ml-auto inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800 dark:bg-red-900/30 dark:text-red-400">{{ badges.rejectedPos }}</span>{% endif %}</a>
                        </li>
                    </ul>
                </li>
                {# ── Admin (VAT Rates) ── #}
                <li>
                    <button type="button" data-nav="section" class="flex w-full items-center rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-gray-900 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800" aria-controls="dropdown-admin" aria-expanded="false" data-action="sidebar-active#toggle">
                        <twig:ux:icon name="flowbite:cog-solid" data-nav="icon" class="h-5 w-5 text-gray-500 dark:text-gray-400"/>
                        <span class="ml-3 flex-1 whitespace-nowrap text-left">Admin</span>
                        <twig:ux:icon name="bi:chevron-down" data-nav="chevron" class="h-4 w-4 text-gray-400"/>
                    </button>
                    <ul id="dropdown-admin" data-nav="dropdown" class="mt-1 hidden space-y-0.5 pl-4">
                        <li>
                            <a href="{{ path('app_pricing_vat_rate_index') }}"
                               data-nav="child"
                               class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                               data-turbo-frame="body"
                               data-action="dialog#close"
                            >VAT Rates</a>
                        </li>
                    </ul>
                </li>
            </ul>
            {# ── Notes (Tickets, Pools) — separated by divider ── #}
            <div class="mt-4 border-t border-gray-200 pt-4 dark:border-white/[0.06]">
                <ul class="space-y-1">
                    <li>
                        <button type="button" data-nav="section" class="flex w-full items-center rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-gray-900 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800" aria-controls="dropdown-notes" aria-expanded="false" data-action="sidebar-active#toggle">
                            <twig:ux:icon name="bi:inbox-fill" data-nav="icon" class="h-5 w-5 text-gray-500 dark:text-gray-400"/>
                            <span class="ml-3 flex-1 whitespace-nowrap text-left">Notes</span>
                            <twig:ux:icon name="bi:chevron-down" data-nav="chevron" class="h-4 w-4 text-gray-400"/>
                        </button>
                        <ul id="dropdown-notes" data-nav="dropdown" class="mt-1 hidden space-y-0.5 pl-4">
                            <li>
                                <a href="{{ path('app_note_ticket_index', {'myPools': 1}) }}"
                                   data-nav="child"
                                   class="flex w-full items-center justify-between rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                                   data-turbo-frame="body"
                                   data-action="dialog#close"
                                >My Queue{% if badges.myQueue > 0 %}<span class="ml-auto inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-800 dark:bg-blue-900/30 dark:text-blue-400">{{ badges.myQueue }}</span>{% endif %}</a>
                            </li>
                            <li>
                                <a href="{{ path('app_note_ticket_index') }}"
                                   data-nav="child"
                                   class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                                   data-turbo-frame="body"
                                   data-action="dialog#close"
                                >Tickets</a>
                            </li>
                            <li>
                                <a href="{{ path('app_note_pool_index') }}"
                                   data-nav="child"
                                   class="flex w-full items-center rounded-lg px-3 py-2 pl-8 text-sm transition-colors text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                                   data-turbo-frame="body"
                                   data-action="dialog#close"
                                >Pools</a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>
    </div>
    </twig:Sheet:Content>
</twig:Sheet>
