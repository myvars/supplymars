{# Hero for the engineering log pages, the same as the About page's.
   Used on: home/log/index, home/log/show. Variables: eyebrow, heading, lede (strings) #}
<section class="relative overflow-hidden">
    <div class="absolute inset-0"
         style="background: url({{ asset('images/martian_landscape.webp') }}) center center no-repeat; background-size: cover;">
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-gray-950/80 via-gray-950/60 to-gray-950"></div>
    <div class="relative text-center px-6 pt-20 sm:pt-28 pb-12 sm:pb-16">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange-500 mb-4">{{ eyebrow }}</p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4 text-balance">{{ heading }}</h1>
        <p class="text-base sm:text-lg text-gray-400 max-w-xl mx-auto">{{ lede }}</p>
    </div>
</section>
