{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block main_class %}grow bg-gray-950{% endblock %}

{% block body %}
    <div data-controller="aos">

    {# ── Header ─────────────────────────────────────────────────────────── #}
    <section class="relative overflow-hidden">
        <div class="absolute inset-0"
             style="background: url({{ asset('images/martian_landscape.webp') }}) center center no-repeat; background-size: cover;">
        </div>
        <div class="absolute inset-0 bg-gradient-to-b from-gray-950/80 via-gray-950/60 to-gray-950"></div>
        <div class="relative text-center px-6 pt-20 sm:pt-28 pb-12 sm:pb-16">
            <p class="text-sm font-semibold uppercase tracking-widest text-orange-500 mb-4">Contact</p>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">Get in Touch</h1>
        </div>
    </section>

    {% embed 'home/_closing_cta.html.twig' with { email: true, style: 'plain' } %}
        {% block body %}
            <p>
                If something on this site caught your attention &mdash; whether it's the architecture, the approach, or the <a href="{{ path('app_about_page') }}" data-turbo-frame="_top" class="text-orange-400 hover:text-orange-300 transition-colors focus-ring">story behind it</a> &mdash; I'd be happy to hear from you.
            </p>
            <p>
                I'm open to the right kind of opportunity, collaboration, or just a good conversation about software.
            </p>
        {% endblock %}
        {% block actions %}
            <twig:CtaButton href="mailto:contact@supplymars.com" icon="bi:envelope-fill" variant="primary">Get in Touch</twig:CtaButton>
            <twig:CtaButton href="{{ path('app_about_page') }}" icon="bi:person-fill">About the Developer</twig:CtaButton>
            <twig:CtaButton href="https://github.com/myvars/supplymars" icon="bi:github">View on GitHub</twig:CtaButton>
        {% endblock %}
    {% endembed %}

    </div>
{% endblock %}
