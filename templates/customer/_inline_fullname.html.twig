{#
    Inline editable customer full name.

    Include this partial in place of a static customer name display.
    The InlineEdit component handles the edit/save flow via Turbo Frames. A user who may not
    edit the customer (CustomerVoter) sees the plain name.

    Variables:
    - customer: The User entity
#}
{% if is_granted('CUSTOMER_EDIT', customer) %}
    <twig:InlineEdit
        editUrl="{{ path('app_customer_inline_fullname', {id: customer.publicId}) }}"
        frameId="inline-edit-customer-{{ customer.publicId }}-fullname"
        displayClass="text-xl font-semibold text-gray-900 line-clamp-1 dark:text-white"
    >
        {{ customer.fullName }}
    </twig:InlineEdit>
{% else %}
    <span class="text-xl font-semibold text-gray-900 line-clamp-1 dark:text-white">{{ customer.fullName }}</span>
{% endif %}
