<!DOCTYPE html>
<html lang="en">
    <head>
        <script>
            (function(){
                if ((localStorage.getItem('theme') || 'dark') === 'dark')
                    document.documentElement.classList.add('dark');
            })();
        </script>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="theme-color" content="#cccccc">
        <link rel="icon" type="image/png" href="{{ asset('images/icons/favicon-96x96.png') }}" sizes="96x96"/>
        <link rel="icon" type="image/svg+xml" href="{{ asset('images/icons/favicon.svg') }}"/>
        <link rel="shortcut icon" href="{{ asset('images/icons/favicon.ico') }}"/>
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('images/icons/apple-touch-icon.png') }}"/>
        <meta name="apple-mobile-web-app-title" content="{{ domain|split('.')|first }}"/>
        <link rel="manifest" href="{{ asset('images/icons/site.webmanifest') }}"/>
        {% if app.environment != 'test' %}
            <meta name="turbo-view-transition" content="true">
            <meta name="turbo-refresh-method" content="replace">
            <meta name="turbo-refresh-scroll" content="preserve">
        {% endif %}
        {% if live_topics|default([]) is not empty %}
            {# Back requests the page again rather than restoring a copy: a copy would reconnect with the last
               page's cookie, which no longer grants these topics #}
            <meta name="turbo-cache-control" content="no-cache">
            {# No hover prefetch: a prefetched page's response replaces the cookie, and when this page's connection
               next reconnects it would no longer be granted these topics #}
            <meta name="turbo-prefetch" content="false">
        {% endif %}
        <title>{% block title %}SupplyMars{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>

    <body class="antialiased bg-gray-100 text-gray-900 dark:bg-gray-950 dark:text-gray-100">
        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-gray-900 focus:shadow-lg dark:focus:bg-gray-800 dark:focus:text-white">Skip to main content</a>
        {% if not playground_mode %}
            <div class="bg-amber-500 px-4 py-1.5 text-center text-xs font-medium tracking-wide text-amber-950">
                This is the live site.
            </div>
        {% endif %}
        <div class="container mx-auto flex min-h-screen flex-col md:px-3">

            <!-- Header -->
            {{ include('_header.html.twig') }}

            <!-- Main -->
            <main id="main-content" class="{% block main_class %}grow bg-gray-100 dark:bg-gray-900{% endblock %}">
                <turbo-frame id="body" data-turbo-action="advance" refresh="morph">
                    {% block body %}{% endblock %}

                    {# Live updates for this page's topics (live_topics, from its controller). Inside the frame, so a
                       visit that changes the frame closes it. Its cookie is set by the element below #}
                    {% if app.user and live_topics|default([]) is not empty %}
                        <turbo-mercure-stream-source src="{{ mercure(live_topics) }}" private></turbo-mercure-stream-source>
                    {% endif %}
                </turbo-frame>
            </main>

            <!-- Footer -->
            {{ include('_footer.html.twig') }}

        </div>

        <!-- Modal -->
        {{ include('shared/turbo/_modal.html.twig') }}

        <!-- Toaster: flash messages on page load, and those appended to #flash-container by Turbo Streams. A live
             refresh's morph keeps it, adding any new flash (live-toaster) -->
        <div data-controller="live-toaster" data-action="turbo:before-morph-element->live-toaster#keep">
            <twig:Sonner id="flash-container" position="top-right" class="top-4 right-4" :closeButton="true" :expand="true">
                {% if not app.request.headers.has('Turbo-Frame') %}
                    {{ include('_flashes.html.twig') }}
                {% endif %}
            </twig:Sonner>
        </div>

        <!-- Live toasts for this user (UserNotifierInterface). The topic is MercureUserNotifier::topic(). Rendering it
             sets the one cookie a request may set, which lets this browser read this user's topic and this page's
             live_topics, nothing else. Permanent, so Turbo visits keep it; the id names the user, so a visit that
             finds another user logged in (in another tab) replaces it -->
        {% if app.user %}
            {% set user_topic = 'user/' ~ app.user.publicId %}
            <div id="user-notifications-{{ app.user.publicId }}" data-turbo-permanent>
                <turbo-mercure-stream-source src="{{ mercure(user_topic, {subscribe: [user_topic]|merge(live_topics|default([]))}) }}" private></turbo-mercure-stream-source>
            </div>
        {% endif %}

    </body>
</html>
