{# Result count ("Showing X-Y of Z") plus page links for a Pagerfanta pager.
   The links come from templates/shared/pagerfanta/default.html.twig, which uses the kit's Pagination.
   - pager: Pagerfanta instance #}
{% props pager %}

{% if pager.count > 0 %}
    <div data-results-pagination class="flex flex-col items-start justify-between gap-3 pt-5 pb-2 md:flex-row md:items-center">
        <p class="text-sm text-muted-foreground">
            Showing
            <span class="tabular-nums font-medium text-gray-700 dark:text-gray-200">
                {{ pager.currentPageOffsetStart }}&ndash;{{ pager.currentPageOffsetEnd }}
            </span>
            of
            <span class="tabular-nums font-medium text-gray-700 dark:text-gray-200">
                {{ pager.count }}
            </span>
        </p>
        <div class="max-w-full overflow-x-auto">
            {{ pagerfanta(pager) }}
        </div>
    </div>
{% endif %}
