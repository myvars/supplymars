{# A call-to-action link on the dark public pages (home, About, Stack, log, Contact, legal), built on the kit's Button.
   Stacks full-width on mobile inside a flex-col sm:flex-row row. A path opens at the top of the page,
   an http(s) URL in a new tab; mailto: is left alone.
   - href: path, URL or mailto:
   - icon: UX icon name
   - variant: primary (orange, one per row) | glass (default)
   Blocks: content (the label) #}
{% props href, icon, variant = 'glass' %}
{%- set styles = {
    primary: 'bg-orange-500 text-white shadow-lg shadow-orange-500/25 hover:bg-orange-400 hover:shadow-lg',
    glass: 'bg-white/[0.06] text-gray-300 ring-1 ring-white/[0.1] backdrop-blur-sm hover:bg-white/[0.1] hover:text-white hover:ring-white/[0.18]',
} -%}
{%- set external = href starts with 'http' -%}
{%- set label %}{% block content %}{% endblock %}{% endset -%}
<twig:Button
    as="a"
    href="{{ href }}"
    {{ ...attributes.defaults({
        class: 'h-auto w-full sm:w-auto gap-2 px-7 py-3 text-sm sm:text-base ' ~ styles[variant],
        target: external ? '_blank' : false,
        rel: external ? 'noopener' : false,
        'data-turbo-frame': href starts with '/' ? '_top' : false,
    }) }}
>
    <twig:ux:icon name="{{ icon }}" class="size-5" />
    {{ label }}
</twig:Button>
