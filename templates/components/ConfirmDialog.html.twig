{# CSRF-protected confirmation dialog, built on ModalPanel. Used for delete confirmations and destructive actions.
   - title: Dialog heading
   - formAction: POST URL for the form submission
   - csrfId: CSRF token identifier (e.g., 'delete' ~ entity.publicId.value)
   - confirmLabel: Text on the confirm button
   - confirmVariant: Button variant for confirm (default: destructive-solid)
   - cancelLabel: Text on the cancel button (default: Cancel)
   Block: message (confirmation text shown above buttons) #}
{% props
    title,
    formAction,
    csrfId,
    confirmLabel,
    confirmVariant = 'destructive-solid',
    cancelLabel = 'Cancel'
%}
{%- set message %}{% block message %}{% endblock %}{% endset -%}
<twig:ModalPanel title="{{ title }}" size="sm">
    <div class="mb-4 flex justify-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-50 dark:bg-red-900/20">
            <twig:ux:icon name="bi:exclamation-triangle-fill" class="h-6 w-6 text-red-500 dark:text-red-400"/>
        </div>
    </div>
    {{ message }}
    <form method="post" action="{{ formAction }}">
        <input type="hidden" name="_token" value="{{ csrf_token(csrfId) }}">
        <div class="flex gap-3">
            <twig:Button type="button" variant="outline" class="flex-1" data-action="basic-modal#close">
                {{ cancelLabel }}
            </twig:Button>
            <twig:Button type="submit" variant="{{ confirmVariant }}" class="flex-1">{{ confirmLabel }}</twig:Button>
        </div>
    </form>
</twig:ModalPanel>
