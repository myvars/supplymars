{# Placeholder shown when a list or section has no content, built on the kit's Empty.
   For anything else (an illustration, several actions), compose <twig:Empty> directly.
   - icon: UX icon name (optional)
   - message: main text
   - subtitle: secondary text (optional)
   Blocks: action (optional, e.g. a button) #}
{% props message, icon = null, subtitle = null %}
{%- set action %}{% block action %}{% endblock %}{% endset -%}
<twig:Empty class="border px-6 py-14" {{ ...attributes }}>
    <twig:Empty:Header>
        {% if icon %}
            <twig:Empty:Media variant="icon" class="size-14 rounded-full text-muted-foreground">
                <twig:ux:icon name="{{ icon }}" class="size-7"/>
            </twig:Empty:Media>
        {% endif %}
        <twig:Empty:Title class="text-muted-foreground">{{ message }}</twig:Empty:Title>
        {% if subtitle %}
            <twig:Empty:Description class="text-xs">{{ subtitle }}</twig:Empty:Description>
        {% endif %}
    </twig:Empty:Header>
    {% if action|trim %}
        <twig:Empty:Content>{{ action }}</twig:Empty:Content>
    {% endif %}
</twig:Empty>
