{# Bordered table with an optional title bar, built on the kit's Table.
   For a bare table, compose <twig:Table> directly.
   - title: Heading shown above the table (optional)
   - caption: Screen-reader caption (default: the title)
   Blocks: head (header rows), body (body rows) — <twig:Table:Row>/<twig:Table:Head>/<twig:Table:Cell>,
   or plain <tr>/<th>/<td> with their own classes #}
{% props title = null, caption = null %}
{%- set head %}{% block head %}{% endblock %}{% endset -%}
{%- set body %}{% block body %}{% endblock %}{% endset -%}
<div {{ attributes.defaults({class: 'overflow-hidden rounded-lg border border-border bg-card'}) }}>
    {% if title %}
        <div class="border-b border-border bg-muted/50 px-4 py-2.5">
            <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{{ title }}</span>
        </div>
    {% endif %}
    <twig:Table class="text-left text-muted-foreground">
        {% if caption or title %}
            <twig:Table:Caption class="sr-only">{{ caption ?? title }}</twig:Table:Caption>
        {% endif %}
        <twig:Table:Header class="bg-muted/50 text-xs font-medium uppercase tracking-wide">{{ head }}</twig:Table:Header>
        <twig:Table:Body class="[&>tr]:border-b [&>tr]:transition-colors [&>tr:hover]:bg-muted/50">{{ body }}</twig:Table:Body>
    </twig:Table>
</div>
