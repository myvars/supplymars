{# Coloured status pill, built on the kit's Badge. Colour resolved via StatusColor utility.
   Props (PHP): status (string, e.g., "ACTIVE"), showIcon (bool, default: false), interactive (bool, default: false — adds hover opacity) #}
{%- set classes = 'h-auto rounded-md px-2.5 py-1 ' ~ this.colorClasses ~ (interactive ? ' duration-150 hover:opacity-80 active:scale-95' : '') -%}
<twig:Badge class="{{ classes }}" {{ ...attributes }}>
    {% if showIcon %}
        <twig:StatusIcon type="{{ status|lower }}"/>
    {% endif %}
    {{ status|replace({'_': ' '})|title }}
</twig:Badge>
