{%- props
    ## 'default'|'info'|'success'|'warning'|'destructive' The visual style variant.
    variant = 'default'
-%}
{%- set style = html_cva(
    base: "group/alert relative grid w-full gap-0.5 rounded-lg border px-2.5 py-2 text-start text-sm has-data-[slot=alert-action]:relative has-data-[slot=alert-action]:pe-18 has-[>svg]:grid-cols-[auto_1fr] has-[>svg]:gap-x-2 *:[svg]:row-span-2 *:[svg]:translate-y-0.5 *:[svg]:text-current *:[svg:not([class*='size-'])]:size-4",
    variants: {
        variant: {
            default: 'bg-card text-card-foreground',
            info: 'border-blue-200 bg-blue-50 text-blue-800 *:data-[slot=alert-description]:text-current dark:border-blue-500/20 dark:bg-blue-500/10 dark:text-blue-400',
            success: 'border-green-200 bg-green-50 text-green-800 *:data-[slot=alert-description]:text-current dark:border-green-500/20 dark:bg-green-500/10 dark:text-green-400',
            warning: 'border-yellow-200 bg-yellow-50 text-yellow-800 *:data-[slot=alert-description]:text-current dark:border-yellow-500/20 dark:bg-yellow-500/10 dark:text-yellow-400',
            destructive: 'border-red-200 bg-red-50 text-red-800 *:data-[slot=alert-description]:text-current dark:border-red-500/20 dark:bg-red-500/10 dark:text-red-400',
        },
    },
) -%}

<div
    data-slot="alert"
    role="alert"
    {{ attributes.defaults({
        class: style.apply({variant: variant})|tailwind_classes,
    }) }}
>
    {##- The alert content, typically includes `Alert:Title` and `Alert:Description`. -#}
    {%- block content %}{% endblock -%}
</div>
