{# Search/list page layout with searchbox, filter, sort headers, result list, and pagination.
   - flowModel: Entity name string (e.g., "Product") — used for headings and turbo-frame IDs
   - routes: FlowRoutes object (.index, .new, .filter)
   - results: Pagerfanta paginated result set
   - showFilter: Show the filter icon in the search bar (default: true)
   - showAdd: Show the "Create" button (default: true)
   Blocks: result_count, filter, add, sort (column headers), list_item (single result card) #}
{% props flowModel, routes, results, showFilter = true, showAdd = true %}

<div class="mx-auto max-w-(--breakpoint-xl) p-3">
    {% block result_count %}
        <div id="{{ flowModel|slug }}-result-count">
            <h1 class="flex items-baseline gap-3 text-xl font-semibold text-gray-900 dark:text-white">
                {{ flowModel }}s
                <span class="text-sm font-normal tabular-nums text-gray-400 dark:text-gray-500">
                    {{ results|length }} {% if results|length == 1 %}result{% else %}results{% endif %}
                </span>
            </h1>
        </div>
    {% endblock %}
    <div class="flex flex-col items-center justify-between py-4 space-y-3 md:space-y-0 md:space-x-3 md:flex-row">
        <div class="w-full md:w-1/2">
            <form data-controller="searchbox"
                  data-turbo-frame="{{ flowModel|slug }}-table"
                  data-turbo-action="replace"
                  data-searchbox-base-path-value="{{ path(routes.index) }}"
            >
                {# Captured only when shown: a list without a filter has no filter route to link to. #}
                {%- if showFilter %}{% set filterLink %}
                    {% block filter %}
                        <a href="{{ path(routes.filter, app.request.query.all) }}"
                           class="flex items-center rounded-sm transition-colors focus-ring"
                           data-turbo-frame="modal"
                           aria-label="Filter {{ flowModel|lower }}s"
                           id="{{ flowModel|slug }}-search-filter">
                            {% if app.request.query.get('filter') %}
                                <twig:ux:icon name="bi:funnel" class="size-5 text-yellow-500 hover:text-yellow-600 dark:text-yellow-400 dark:hover:text-yellow-200"/>
                            {% else %}
                                <twig:ux:icon name="bi:funnel" class="size-5 text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300"/>
                            {% endif %}
                        </a>
                    {% endblock %}
                {% endset %}{% endif -%}
                <twig:InputGroup class="bg-background">
                    <twig:InputGroup:Addon class="ps-3">
                        <twig:ux:icon name="flowbite:search-outline" class="size-4.5"/>
                    </twig:InputGroup:Addon>
                    <twig:InputGroup:Input
                        type="text"
                        name="query"
                        value="{{ app.request.query.get('query') }}"
                        data-searchbox-target="queryInput"
                        data-action="input->searchbox#debouncedQueryInputChanged"
                        aria-label="Search"
                        autocomplete="off"
                        autofocus
                        placeholder="Search {{ flowModel|lower }}s..."
                    />
                    {% if showFilter %}
                        <twig:InputGroup:Addon align="inline-end" class="pe-3">{{ filterLink }}</twig:InputGroup:Addon>
                    {% endif %}
                </twig:InputGroup>
            </form>
        </div>
        <div
            class="flex w-full shrink-0 flex-col items-stretch justify-end space-y-2 md:space-y-0 md:space-x-3 md:w-auto md:flex-row md:items-center">
            {% block add %}
                {% if showAdd and routes.new %}
                    <twig:Button
                        as="a"
                        variant="outline"
                        href="{{ path(routes.new) }}"
                        data-turbo-frame="modal"
                    >
                        <twig:ux:icon name="bi:plus-lg" class="h-4 w-4"/>
                        <span>Create {{ flowModel }}</span>
                    </twig:Button>
                {% endif %}
            {% endblock %}
        </div>
    </div>

    <turbo-frame id="{{ flowModel|slug }}-table" data-turbo-action="advance" refresh="morph">
        <div class="sticky top-0 z-10 rounded-lg border border-gray-200 bg-gray-50 px-4 py-2.5 dark:border-white/[0.06] dark:bg-gray-800/80">
            <div class="flex justify-between overflow-auto">
                {% block sort %}{% endblock %}
            </div>
        </div>
        <ul class="mt-3 space-y-3">
            {% for result in results %}
                <li>{% block list_item %}{% endblock %}</li>
            {% else %}
                <li class="mt-3">
                    <twig:EmptyState icon="flowbite:search-outline" message="No {{ flowModel|lower }}s found" subtitle="Try adjusting your search or filters"/>
                </li>
            {% endfor %}
        </ul>
        <twig:ResultsPagination pager="{{ results }}"></twig:ResultsPagination>

        <turbo-stream action="replace" target="{{ flowModel|slug }}-result-count">
            <template>
                {{ block('result_count') }}
            </template>
        </turbo-stream>

        {% if showFilter %}
            <turbo-stream action="replace" target="{{ flowModel|slug }}-search-filter">
                <template>
                    {{ block('filter') }}
                </template>
            </turbo-stream>
        {% endif %}
    </turbo-frame>
</div>
