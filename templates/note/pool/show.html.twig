{# Pool detail page — composes _pool_card and subscription toggle.
   Variable: result (Pool), is_subscribed (bool) #}
{% extends 'base.html.twig' %}

{% block title %}Pool Details{% endblock %}

{% block body %}

    <div class="m-3 space-y-4">
        <twig:PageBreadcrumb :href="path('app_note_pool_index')" label="Pools" :current="result.name"/>
        {{ include('note/pool/_pool_card.html.twig', {pool: result}) }}

        <twig:EntityCard title="Subscription">
            <div class="flex items-center justify-between">
                <p class="text-sm text-gray-600 dark:text-gray-400">
                    {{ is_subscribed ? 'You are subscribed to this pool.' : 'You are not subscribed to this pool.' }}
                </p>
                <form method="post" action="{{ path('app_note_pool_toggle_subscription', {'id': result.publicId.value}) }}" data-turbo-frame="body">
                    <input type="hidden" name="_token" value="{{ csrf_token('subscribe' ~ result.publicId.value) }}">
                    <twig:Button type="submit" size="sm" variant="{{ is_subscribed ? 'secondary' : 'default' }}">
                        <twig:ux:icon name="{{ is_subscribed ? 'bi:bell-slash' : 'bi:bell' }}"/>
                        {{ is_subscribed ? 'Unsubscribe' : 'Subscribe' }}
                    </twig:Button>
                </form>
            </div>
        </twig:EntityCard>

    </div>

{% endblock %}
