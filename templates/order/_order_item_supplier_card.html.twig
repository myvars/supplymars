{# Expandable supplier breakdown for an order item — shows PO item allocations.
   Used on: order show page (toggled inside _order_item_card). Variable: orderItem (CustomerOrderItem) #}
<ul
    data-toggle-target="toggleable"
    class="hidden w-full divide-y divide-gray-100 border-t border-gray-100 bg-gray-50/50 dark:divide-gray-800 dark:border-white/[0.06] dark:bg-gray-900/80"
>
    {% if orderItem.outstandingQty > 0 %}
        {% for supplierProduct in orderItem.product.activeSupplierProducts %}
            <li>
                <form method="post"
                      action="{{ path('app_purchase_order_item_add', {
                          'id': orderItem.publicId.value,
                          'supplierProductId': supplierProduct.publicId.value
                      }) }}"
                      data-turbo-frame="body"
                >
                    <input type="hidden" name="_token" value="{{ csrf_token('po_add' ~ orderItem.publicId.value) }}">
                    <button type="submit" class="flex w-full items-center justify-between px-3 py-2.5 text-left text-sm transition-colors hover:bg-gray-100 focus-ring dark:hover:bg-gray-700">
                        <span>
                            <span class="flex items-center gap-1.5 font-medium text-gray-700 line-clamp-1 dark:text-gray-400"><twig:SupplierDot colour="{{ supplierProduct.supplier.colourScheme }}"/>{{ supplierProduct.supplier.name }}</span>
                            <span class="block mt-0.5 text-xs text-gray-400 dark:text-gray-500">{{ supplierProduct.productCode }}</span>
                        </span>
                        <span class="text-right">
                            <span class="block font-medium tabular-nums text-gray-900 dark:text-white">{{ supplierProduct.cost|format_currency('GBP') }}</span>
                            <span class="block mt-0.5 text-xs">
                                {% if supplierProduct.hasStock %}
                                    <span class="text-green-600 dark:text-green-400">{{ supplierProduct.stock }} in stock</span>
                                {% else %}
                                    <span class="text-amber-600 dark:text-amber-400">{{ supplierProduct.leadTimeDays }}d lead time</span>
                                {% endif %}
                            </span>
                        </span>
                    </button>
                </form>
            </li>
        {% else %}
            <li class="px-3 py-3 text-center text-sm text-gray-400 dark:text-gray-500">No suppliers found</li>
        {% endfor %}
    {% endif %}
</ul>
