{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "babdev/pagerfanta-bundle": "^4.6",
        "beberlei/doctrineextensions": "^1.5",
        "checkthiscloud/phpamqplib-messenger": "^0.11.1",
        "doctrine/dbal": "^4.4.3",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.7",
        "fakerphp/faker": "^1.24.1",
        "friendsofphp/proxy-manager-lts": "^1.0.19",
        "knplabs/knp-time-bundle": "^2.5",
        "league/flysystem-aws-s3-v3": "^3.34.0",
        "liip/imagine-bundle": "^2.17.1",
        "nelmio/api-doc-bundle": "^5.10.3",
        "oneup/flysystem-bundle": ">=4.14.1",
        "pagerfanta/doctrine-orm-adapter": "^4.8",
        "pagerfanta/twig": "^4.8",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.2",
        "snc/redis-bundle": "^4.11.1",
        "stof/doctrine-extensions-bundle": "^1.15.3",
        "symfony/amazon-mailer": "8.1.*",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.11.0",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/notifier": "8.1.*",
        "symfony/object-mapper": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.1",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/ux-chartjs": "^3.1",
        "symfony/ux-icons": "^3.1",
        "symfony/ux-turbo": "^3.1",
        "symfony/ux-twig-component": "^3.1",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/yaml": "8.1.*",
        "symfonycasts/dynamic-forms": "^0.2.0",
        "symfonycasts/reset-password-bundle": "^1.25.0",
        "symfonycasts/tailwind-bundle": "^0.12.0",
        "symfonycasts/verify-email-bundle": "^1.18.0",
        "tales-from-a-dev/flowbite-bundle": "^0.9.2",
        "twig/cssinliner-extra": "^3.26",
        "twig/extra-bundle": "^2.12|^3.24.0",
        "twig/inky-extra": "^3.26",
        "twig/intl-extra": "^3.26.0",
        "twig/string-extra": "^3.24.0",
        "twig/twig": "^2.12|^3.27.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6.0",
        "dg/bypass-finals": "^1.10",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.3",
        "phpstan/phpstan": "^2.2.1",
        "phpstan/phpstan-doctrine": "^2.0.23",
        "phpstan/phpstan-symfony": "^2.0.19",
        "phpunit/phpunit": "^13.1.13",
        "rector/rector": "^2.4.5",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67.0",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "zenstruck/browser": "^1.10.1",
        "zenstruck/foundry": "2.10.1"
    }
}
