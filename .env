# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> docker ###
# The database name and local ports. Docker Compose reads them from this file, and the URLs below are
# built from them. Change them here, not in .env.local: the test environment does not read .env.local.
DATABASE_NAME=app
DATABASE_PORT=3306
REDIS_PORT=6379
MAILER_PORT=1025
MAILPIT_PORT=8025
PHPMYADMIN_PORT=8080
PHPMYADMIN_LIVE_PORT=8081
PHPMYADMIN_PLAYGROUND_PORT=8082
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
MERCURE_PORT=3001
###< docker ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL=mysql://root:password@127.0.0.1:${DATABASE_PORT}/${DATABASE_NAME}?serverVersion=8.4&charset=utf8mb4
###< doctrine/doctrine-bundle ###

###> snc/redis-bundle ###
# passwords that contain special characters (@, %, :, +) must be urlencoded
# Redis enforces REDIS_PASSWORD (compose.yaml; the dev value is in compose.override.yaml); this URL must carry the same password
REDIS_URL=redis://default:password@127.0.0.1:${REDIS_PORT}
###< snc/redis-bundle ###

###> symfony/messenger ###
# The queue is a database table by default. For RabbitMQ, see "Switching to RabbitMQ" in Docs/02-setup-local.md.
MESSENGER_TRANSPORT_DSN=doctrine://default
# MESSENGER_TRANSPORT_DSN="phpamqplib://guest:guest@127.0.0.1:${RABBITMQ_PORT}/%2f/messages"
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://127.0.0.1:${MAILER_PORT}
DEV_MAIL_RECIPIENT=dev@supplymars.com
MAILER_FROM=no-reply@supplymars.com
###< symfony/mailer ###

DEFAULT_DOMAIN=supplymars
### Trusted proxies
# Addresses whose X-Forwarded-For and X-Forwarded-Proto are believed (config/packages/framework.yaml).
# private_ranges covers the host Caddy, which reaches the container through Docker's network.
TRUSTED_PROXIES=private_ranges

###> symfony/routing ###
### :8000 for local symfony server development
DEFAULT_URI=https://localhost:8000
###< symfony/routing ###

###> cloudflare/turnstile ###
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
###< cloudflare/turnstile ###

### AWS S3 Configuration
AWS_S3_REGION=eu-west-2
AWS_S3_BUCKET=unicorn-bucket-two
AWS_S3_ACCESS_ID=dev-access-id
AWS_S3_SECRET_ACCESS_KEY=dev-secret-key
AWS_S3_PRODUCTS_PREFIX=
UPLOADS_BASE_URL=

###> app/defaults ###
DEFAULT_STAFF_EMAIL=admin@supplymars.com
###< app/defaults ###

###> playground ###
PLAYGROUND_MODE=0
###< playground ###

###> sentry/sentry-symfony ###
# Error tracking, production only. Empty sends nothing; set the DSN in the stack's env file in ../supplymars-secrets/.
SENTRY_DSN=
# Tags each event with the stack that sent it: live or playground
SENTRY_ENVIRONMENT=live
###< sentry/sentry-symfony ###

###> symfony/lock ###
# Stops two backups overlapping, and two workers running the same scheduled job. flock locks files in the
# container's temp directory, so it only excludes processes in the same container: run a manual backup in
# messenger, where the scheduler runs.
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mercure-bundle ###
# Live updates to the browser (Docs/patterns/Turbo/README.md#live-updates-with-mercure). The hub is FrankenPHP's
# own under make up and in production, and the mercure container of make up-dev-tools under symfony serve,
# which serves it on the site's origin (proxy_mercure in .symfony.local.yaml) and sets both URLs itself.
# MERCURE_URL is where the app publishes; MERCURE_PUBLIC_URL is where the browser subscribes.
MERCURE_URL=http://127.0.0.1:${MERCURE_PORT}/.well-known/mercure
MERCURE_PUBLIC_URL=https://localhost:8000/.well-known/mercure
# Signs the publisher's and the subscribers' tokens; the hub verifies both with it. At least 32 characters
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
# The iss claim of those tokens, which the hub must trust. Fixed, not DEFAULT_URI: symfony serve sets that to
# its own address for the web server, and the worker would sign with another
MERCURE_JWT_ISSUER=https://localhost
# The __Secure- prefix needs an https MERCURE_PUBLIC_URL; compose.prod.local.yaml drops it for plain HTTP
MERCURE_COOKIE_NAME=__Secure-mercure_access_token
###< symfony/mercure-bundle ###
