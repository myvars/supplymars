parameters:
	ignoreErrors:
		# Kept empty by discipline — add entries only when PHPStan's verdict is
		# correct from its analytical view but wrong against a vendor contract
		# PHPStan can't see, AND no in-code fix preserves the vendor canonical.
		# Each entry needs a comment explaining why it can't be fixed in the
		# code itself, so future maintainers can drop it as PHPStan / its
		# extensions catch up.

		# `Kernel::getAllowedEnvs()` is a hook generated by the
		# `symfony/framework-bundle` recipe. The Symfony
		# `KernelTrait::loadFromExtensions` (vendor) calls it via late binding
		# (`$this->getAllowedEnvs()`) to enforce strict APP_ENV validation. The
		# trait declares its own `private` version with `return []`; the
		# overriding `private` here flips on enforcement to `prod|dev|test`.
		# PHPStan sees the override as an unused private method because it
		# doesn't trace the trait's caller into this class. Keeping the
		# recipe-canonical `private` visibility is preferable to widening to
		# `protected` (which would diff against every future
		# `composer recipes:update` and risk a silent revert). Drop this entry
		# if `phpstan-symfony` (or core PHPStan) learns to model trait-hook
		# overrides — see https://github.com/phpstan/phpstan-symfony.
		-
			message: '#^Method App\\Kernel::getAllowedEnvs\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: src/Kernel.php
