parameters:
	# Kept empty by discipline — add entries only when PHPStan's verdict is
	# correct from its analytical view but wrong against a vendor contract
	# PHPStan can't see, AND no in-code fix preserves the vendor canonical.
	# Each entry needs a comment explaining why it can't be fixed in the
	# code itself, so future maintainers can drop it as PHPStan / its
	# extensions catch up.
	ignoreErrors: []
